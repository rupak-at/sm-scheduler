# Local development only. Set real environment variables in deployed services.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
# Browser-reachable Express origin. Use HTTPS on your VPS; direct media uploads use this URL.
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://scheduler:scheduler_dev@localhost:5432/social_scheduler?schema=public
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2
# Generate an untracked random secret with npm run setup:env.
BETTER_AUTH_SECRET=

# Instagram API with Instagram Login (Business/Creator accounts). See docs/instagram-setup.md.
# Use Instagram app credentials, not Facebook Login app credentials.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Pin a version supported by your Meta app dashboard (e.g. v25.0).
INSTAGRAM_GRAPH_VERSION=
# Must exactly match WEB_ORIGIN + /api/auth/instagram/callback; use an HTTPS tunnel locally.
INSTAGRAM_REDIRECT_URI=
# Facebook Pages via Facebook Login. Use Facebook app credentials; see docs/facebook-setup.md.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Pin a supported Meta Graph API version (research verified v26.0 references).
FACEBOOK_GRAPH_VERSION=
# Must exactly match WEB_ORIGIN + /api/auth/facebook/callback.
FACEBOOK_REDIRECT_URI=
# If your Meta app uses Facebook Login for Business, set its configuration ID.
FACEBOOK_LOGIN_CONFIG_ID=

# TikTok Login Kit + Content Posting Direct Post. See docs/tiktok-setup.md.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# HTTPS Express origin, verified in TikTok URL properties. Serves signed media without redirects.
TIKTOK_MEDIA_ORIGIN=
# Set true only after TikTok approves the Direct Post audit; false permits private-account/Only me tests.
TIKTOK_DIRECT_POST_AUDITED=false
# YouTube Data API channel connection and resumable video uploads. See docs/youtube-setup.md.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must exactly match WEB_ORIGIN + /api/auth/youtube/callback.
YOUTUBE_REDIRECT_URI=
# Independent 32-byte base64 key. Generated by setup:env; share securely with API and worker.
TOKEN_ENCRYPTION_KEY=
# Optional HTTPS origin for previously uploaded local media only. Cloudinary media does not use this.
MEDIA_PUBLIC_URL=
# Legacy local uploads only. New media is stored in Cloudinary; paths resolve from the repo root.
MEDIA_STORAGE_PATH=.data/media

# Cloudinary credentials: API and worker only. See docs/cloudinary-setup.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use separate folders/clouds for development and deployed staging/production.
CLOUDINARY_FOLDER=social-scheduler

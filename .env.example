# Local development only. Set real environment variables in deployed services.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://scheduler:scheduler_dev@localhost:5432/social_scheduler?schema=public
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2
# Generate an untracked random secret with npm run setup:env.
BETTER_AUTH_SECRET=

# Instagram API with Instagram Login (Business/Creator accounts). See docs/instagram-setup.md.
# Use Instagram app credentials, not Facebook Login app credentials.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Pin a version supported by your Meta app dashboard (e.g. v25.0).
INSTAGRAM_GRAPH_VERSION=
# Must exactly match WEB_ORIGIN + /api/auth/instagram/callback; use an HTTPS tunnel locally.
INSTAGRAM_REDIRECT_URI=
# Independent 32-byte base64 key. Generated by setup:env; share securely with API and worker.
TOKEN_ENCRYPTION_KEY=
# HTTPS origin serving /api/media/public/:id, reachable by Meta. Usually your web tunnel origin.
MEDIA_PUBLIC_URL=
# API and worker must share the same persistent directory. Paths resolve from the repo root.
MEDIA_STORAGE_PATH=.data/media

{
  "name": "social-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "prepare": "husky",
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "npm run build:packages && concurrently --kill-others -n shared,frontend,backend \"npm run dev:packages\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:packages": "npm run dev -w @social-scheduler/shared",
    "dev:web": "npm run dev:frontend",
    "dev:api": "npm run dev:api -w @social-scheduler/backend",
    "dev:worker": "npm run dev:worker -w @social-scheduler/backend",
    "build:packages": "npm run db:generate && npm run build -w @social-scheduler/shared",
    "build": "npm run build:backend && npm run build -w @social-scheduler/frontend",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "npm run build:packages && vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build:packages && vitest run --config vitest.integration.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:generate": "npm run db:generate -w @social-scheduler/backend",
    "db:validate": "npm run db:validate -w @social-scheduler/backend",
    "db:check": "npm run build:backend && npm run db:check -w @social-scheduler/backend",
    "db:migrate": "npm exec -w @social-scheduler/backend -- prisma migrate dev",
    "db:deploy": "npm run db:deploy -w @social-scheduler/backend",
    "db:studio": "npm run db:studio -w @social-scheduler/backend",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "queue:check": "npm run queue:check -w @social-scheduler/backend",
    "dev:frontend": "npm run dev -w @social-scheduler/frontend",
    "dev:backend": "npm run dev -w @social-scheduler/backend",
    "build:backend": "npm run build:packages && npm run build -w @social-scheduler/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
